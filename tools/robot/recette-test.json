      "title": "Test du robot (eau)",
      "category": "Test",
      "tags": ["test"],
      "servings": 1,
      "prepMinutes": 2,
      "totalMinutes": 8,
      "difficulty": 1,
      "source": "user",
      "notes": "Recette fictive pour tester pesée, moteur, chauffe et API. Eau seule, aucun aliment.",
      "ingredients": [
        { "group": "", "items": [ { "qty": "400", "unit": "g", "name": "eau", "note": "300 g puis 100 g" } ] }
      ],
      "steps": [
        { "text": "Peser 300 g d'eau dans le bol.", "weigh": { "label": "Eau", "grams": 300 } },
        { "text": "Moteur vitesse 2, chauffe à 45 °C.",
          "machine": { "program": "manuel", "seconds": 30, "speed": 2, "tempC": 45 } },
        { "text": "Vitesse 3, toujours 45 °C.",
          "machine": { "program": "manuel", "seconds": 30, "speed": 3, "tempC": 45 } },
        { "text": "Vitesse 4, chauffe coupée (au-delà de 3, pas de chauffe).",
          "machine": { "program": "manuel", "seconds": 30, "speed": 4, "tempC": 0 } },
        { "text": "Vitesse 5, chauffe coupée.",
          "machine": { "program": "manuel", "seconds": 30, "speed": 5, "tempC": 0 } },
        { "text": "Le moteur est à l'arrêt. Peser 100 g d'eau et les ajouter.", "weigh": { "label": "Eau", "grams": 100 } },
        { "text": "Vitesse 3, montée à 65 °C.",
          "machine": { "program": "manuel", "seconds": 180, "speed": 3, "tempC": 65 } },
        { "text": "Maintenir 65 °C pendant 30 s.",
          "machine": { "program": "manuel", "seconds": 30, "speed": 3, "tempC": 65 } },
        { "text": "Fin de la recette de test : vider le bol." }
      ]
    }
